# Situs utama taram.id. Berkas ini juga dibaca untuk subfolder (termasuk layanan),
# jadi setiap aturan dibatasi ke host taram.id / www.taram.id.
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Satu alamat kanonik: https://taram.id (HTTPS sudah dipaksa oleh hosting).
    RewriteCond %{HTTP_HOST} ^www\.taram\.id$ [NC]
    RewriteRule ^(.*)$ https://taram.id/$1 [R=301,L]

    # Halaman bawaan hosting tidak dipakai lagi.
    RewriteCond %{HTTP_HOST} ^taram\.id$ [NC]
    RewriteRule ^default\.php$ / [R=301,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
